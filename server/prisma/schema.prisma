generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GroupRole {
  OWNER
  MEMBER
}

enum SplitType {
  EQUAL
  EXACT
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String

  isGoogleUser   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groupsCreated    Group[]       @relation("GroupCreator")
  groupMemberships GroupMember[]

  paidExpenses Expense[] @relation("ExpensePayer")

  expenseParticipations ExpenseParticipant[]

  settlementsMade Settlement[] @relation("SettlementPayer")

  settlementsReceived Settlement[] @relation("SettlementReceiver")
}

model Group {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdBy   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator User @relation("GroupCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  members  GroupMember[]
  expenses Expense[]
  settlements Settlement[]
}

model GroupMember {
  groupId Int
  userId  Int

  role GroupRole @default(MEMBER)

  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
}

model Expense {
  id          Int     @id @default(autoincrement())
  description String
  totalAmount Decimal @db.Decimal(10, 2)

  splitType   SplitType @default(EQUAL)
 
  groupId Int
  paidBy  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer User @relation("ExpensePayer", fields: [paidBy], references: [id], onDelete: Cascade)

  participants ExpenseParticipant[]
}

model ExpenseParticipant {
  expenseId Int
  userId    Int

  shareAmount Decimal @db.Decimal(10, 2)
  amountPaid  Decimal @default(0) @db.Decimal(10, 2)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([expenseId, userId])
}

model Settlement {
  id          Int      @id @default(autoincrement())

  groupId     Int
  payerId     Int
  receiverId  Int

  amount      Decimal  @db.Decimal(10,2)

  createdAt   DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  payer User @relation("SettlementPayer", fields: [payerId], references: [id], onDelete: Cascade)

  receiver User @relation("SettlementReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
}
